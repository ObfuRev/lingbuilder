包 TCP与UDP IPv6通信演示
使用 Win32窗口基础模块
使用 TCP通信模块
使用 UDP通信模块

// 演示 TCP 客户端与 UDP 数据报在 IPv6/IPv4 双栈下的连接、发送、接收。
// 默认目标 ::1 是本机回环 IPv6 地址；地址栏也可以填 IPv4 地址或域名。
// 连接成功与失败都会弹提示框，并把详细过程写进底部运行日志。
类 MainWindow : 公开 窗口
    逻辑型 UDP已绑定 = 假

    事件 _MainWindow_创建完毕()
        控件_设置只读(运行日志, 真)
        控件_设置文本(运行日志, "欢迎使用 TCP 与 UDP IPv6 通信演示。\n默认地址 ::1 是本机回环 IPv6；也可以填 IPv4 地址或域名（域名同时有 A 和 AAAA 记录时优先 IPv4）。\nTCP：请先运行 README 里附带的「TCP回声服务器.ps1」，再点「连接」。\nUDP：请先运行「UDP回声服务器.ps1」，点「绑定端口」后即可收发数据报。")
        控件_设置文本(TCP状态, "TCP：未连接")
        控件_设置文本(UDP状态, "UDP：未绑定")
    结束

    // 把一行文本追加到底部日志框，并自动滚动到最后一行。
    空 写日志(文本型 新行)
        局部 文本型 当前文本
        当前文本 = 控件_取文本(运行日志)
        控件_设置文本(运行日志, 当前文本 + 新行 + "\n")
        编辑框_滚动到底(运行日志)
    结束

    事件 _TCP连接按钮_被单击()
        局部 整数型 端口
        局部 逻辑型 连接结果
        端口 = 到整数(控件_取文本(TCP端口))
        如果 (端口 < 1 或 端口 > 65535)
            写日志("TCP 连接失败：端口不是有效的 1~65535 数字（当前填的是「" + 控件_取文本(TCP端口) + "」）。")
            信息框("TCP 连接失败：端口不是有效的数字，请填 1 到 65535。", 48, "TCP 连接结果")
        否则
            写日志("正在连接 " + 控件_取文本(TCP地址) + ":" + 到文本(端口) + " …（最多等 2 秒）")
            连接结果 = TCP_连接(控件_取文本(TCP地址), 端口, 2000)
            如果 (连接结果)
                控件_设置文本(TCP状态, "TCP：已连接")
                写日志("TCP 连接成功：已连上 " + 控件_取文本(TCP地址) + ":" + 到文本(端口) + "，可以发送和接收数据了。")
                信息框("TCP 连接成功！详细信息见运行日志。", 64, "TCP 连接结果")
            否则
                控件_设置文本(TCP状态, "TCP：未连接")
                写日志("TCP 连接失败：" + TCP_取错误() + "（请确认服务端已启动、地址与端口无误。）")
                信息框("TCP 连接失败！失败原因见运行日志。", 48, "TCP 连接结果")
            如果结束
        如果结束
    结束

    事件 _TCP发送按钮_被单击()
        局部 整数型 字节数
        如果 (TCP_是否已连接())
            字节数 = TCP_发送文本(控件_取文本(TCP发送内容))
            如果 (字节数 >= 0)
                控件_设置文本(TCP状态, "TCP：已发送 " + 到文本(字节数) + " 字节")
                写日志("TCP 已发送 " + 到文本(字节数) + " 字节：" + 控件_取文本(TCP发送内容))
            否则
                控件_设置文本(TCP状态, "TCP：未连接")
                写日志("TCP 发送失败：" + TCP_取错误() + "（连接可能已断开，请重新连接。）")
                信息框("TCP 发送失败！连接可能已断开，请重新连接。", 48, "TCP 发送结果")
            如果结束
        否则
            写日志("TCP 尚未连接：请先点「连接」再发送。")
            信息框("TCP 尚未连接，请先点「连接」再发送数据。", 48, "TCP 发送结果")
        如果结束
    结束

    事件 _TCP接收按钮_被单击()
        局部 文本型 收到
        如果 (TCP_是否已连接())
            写日志("等待接收数据…（最多 2 秒）")
            收到 = TCP_接收文本(4096)
            如果 (收到 != "")
                控件_设置文本(TCP状态, "TCP：已收到数据")
                写日志("TCP 收到：" + 收到)
            否则
                写日志("TCP 2 秒内没有收到数据（对方可能没回复，或连接已断开）。")
            如果结束
        否则
            写日志("TCP 尚未连接：请先点「连接」再接收。")
        如果结束
    结束

    事件 _TCP断开按钮_被单击()
        如果 (TCP_是否已连接())
            TCP_关闭()
            控件_设置文本(TCP状态, "TCP：未连接")
            写日志("TCP 连接已主动断开。")
        否则
            写日志("TCP 本来就没有连接，无需断开。")
        如果结束
    结束

    事件 _UDP绑定按钮_被单击()
        局部 整数型 端口
        局部 逻辑型 绑定结果
        端口 = 到整数(控件_取文本(UDP本机端口))
        如果 (端口 < 0 或 端口 > 65535)
            写日志("UDP 绑定失败：端口不是有效的 0~65535 数字（当前填的是「" + 控件_取文本(UDP本机端口) + "」）。")
            信息框("UDP 绑定失败：端口不是有效的数字，请填 0 到 65535。", 48, "UDP 绑定结果")
        否则
            绑定结果 = UDP_绑定(端口)
            如果 (绑定结果)
                UDP已绑定 = 真
                控件_设置文本(UDP状态, "UDP：已绑定端口 " + 到文本(端口))
                写日志("UDP 绑定成功：本机端口 " + 到文本(端口) + "（IPv4/IPv6 双栈，两族数据报都能收）。")
            否则
                UDP已绑定 = 假
                控件_设置文本(UDP状态, "UDP：未绑定")
                写日志("UDP 绑定失败：" + UDP_取错误() + "（端口可能已被占用，换个端口重试。）")
                信息框("UDP 绑定失败！原因见运行日志。", 48, "UDP 绑定结果")
            如果结束
        如果结束
    结束

    事件 _UDP发送按钮_被单击()
        局部 整数型 目标端口
        局部 整数型 字节数
        如果 (UDP已绑定)
            目标端口 = 到整数(控件_取文本(UDP目标端口))
            如果 (目标端口 < 1 或 目标端口 > 65535)
                写日志("UDP 发送失败：目标端口不是有效的 1~65535 数字。")
                信息框("UDP 发送失败：目标端口不是有效的数字，请填 1 到 65535。", 48, "UDP 发送结果")
            否则
                字节数 = UDP_发送文本(控件_取文本(UDP目标地址), 目标端口, 控件_取文本(UDP发送内容))
                如果 (字节数 >= 0)
                    控件_设置文本(UDP状态, "UDP：已发送数据报")
                    写日志("UDP 已发送 " + 到文本(字节数) + " 字节 → " + 控件_取文本(UDP目标地址) + ":" + 到文本(目标端口))
                否则
                    写日志("UDP 发送失败：" + UDP_取错误())
                    信息框("UDP 发送失败！原因见运行日志。", 48, "UDP 发送结果")
                如果结束
            如果结束
        否则
            写日志("UDP 尚未绑定端口：请先点「绑定端口」再发送。")
            信息框("UDP 尚未绑定端口，请先点「绑定端口」。", 48, "UDP 发送结果")
        如果结束
    结束

    事件 _UDP接收按钮_被单击()
        局部 文本型 收到
        如果 (UDP已绑定)
            写日志("等待接收数据报…（最多 1 秒）")
            收到 = UDP_接收文本(1024, 1000)
            如果 (收到 != "")
                控件_设置文本(UDP状态, "UDP：已收到数据报")
                写日志("UDP 收到来自 " + UDP_取来源地址() + ":" + 到文本(UDP_取来源端口()) + " 的数据：" + 收到)
            否则
                写日志("UDP 1 秒内没有收到数据报（对方可能没发，或目标端口不对）。")
            如果结束
        否则
            写日志("UDP 尚未绑定端口：请先点「绑定端口」再接收。")
        如果结束
    结束

    事件 _清空日志按钮_被单击()
        控件_设置文本(运行日志, "")
    结束

结束类
